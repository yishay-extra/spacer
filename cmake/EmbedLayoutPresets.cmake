# Embeds resources/layouts/*.json into a generated C++ include so spacer_core
# has no runtime file dependency and needs no JUCE BinaryData.
#
#   spacer_embed_layout_presets(<target> <layouts-dir>)
function(spacer_embed_layout_presets target layouts_dir)
    file(GLOB preset_files CONFIGURE_DEPENDS "${layouts_dir}/*.json")
    list(SORT preset_files)
    set(out "// Generated by cmake/EmbedLayoutPresets.cmake. Do not edit.\n")
    string(APPEND out "struct LayoutPresetSource {\n    const char* id;\n    const char* json;\n};\n")
    string(APPEND out "inline constexpr LayoutPresetSource kLayoutPresetSources[] = {\n")
    foreach(f ${preset_files})
        get_filename_component(fname "${f}" NAME)
        string(REGEX REPLACE "\\.json$" "" id "${fname}")
        file(READ "${f}" content)
        string(APPEND out "    {\"${id}\", R\"spacerjson(${content})spacerjson\"},\n")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${f}")
    endforeach()
    string(APPEND out "};\n")
    set(gen_dir "${CMAKE_CURRENT_BINARY_DIR}/generated")
    file(WRITE "${gen_dir}/LayoutPresetsData.inc.tmp" "${out}")
    configure_file("${gen_dir}/LayoutPresetsData.inc.tmp" "${gen_dir}/LayoutPresetsData.inc" COPYONLY)
    target_include_directories(${target} PRIVATE "${gen_dir}")
endfunction()
